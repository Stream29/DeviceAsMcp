# Copy to .env.production and replace every value.
# Keep passwords URL-safe: letters, digits, underscores, and hyphens.
DEVICE_AS_MCP_DOMAIN=mcp.example.com
DATABASE_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
RABBITMQ_USER=device_as_mcp
RABBITMQ_PASSWORD=replace-with-a-long-random-value

# Leave both empty to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional JSON array on one line.
OAUTH_PRE_REGISTERED_CLIENTS=
DEVICE_AS_MCP_LOG_LEVEL=INFO
